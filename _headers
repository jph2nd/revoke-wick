# Cloudflare Pages security headers.
#
# Mirrors vercel.json so the protections apply on whichever host serves the
# site. Cloudflare Pages reads this file and does not serve it.
#
# The two that matter most for a wallet-connecting dApp:
#   frame-ancestors / X-Frame-Options  -- stops the site being framed inside a
#     phishing wrapper while the victim believes they are on the real domain.
#   script-src 'self'                  -- the page has zero inline scripts, so
#     injected markup still cannot execute. That is what a wallet drainer needs.

/*
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src https://pulsechain-rpc.publicnode.com https://pulsechain.publicnode.com https://rpc-pulsechain.g4mm4.io https://rpc.pulsechain.com; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
